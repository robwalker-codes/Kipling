{
  "name": "kipling-terminal",
  "version": "1.0.0",
  "description": "A browser-based behavioural reconstruction of the KIPLING tactical data terminal.",
  "scripts": {
    "test": "vitest run src",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build --base=./",
    "lint": "eslint src tests",
    "e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robwalker-codes/Kipling.git"
  },
  "type": "module",
  "bugs": {
    "url": "https://github.com/robwalker-codes/Kipling/issues"
  },
  "homepage": "https://github.com/robwalker-codes/Kipling#readme",
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "lucide-react": "^1.76.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
